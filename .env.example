############################################################
# NETLIFE CASH — Self-hosted Supabase Environment Config
# Copy this file to .env and fill in every value.
############################################################

# ── Site URLs ────────────────────────────────────────────
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# ── Postgres ─────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# CHANGE THIS — use a long random string
POSTGRES_PASSWORD=your-super-secret-db-password

# ── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-chars
JWT_EXPIRY=3600

# Generate ANON and SERVICE keys using the helper script:
#   bash generate-keys.sh
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Studio Dashboard ─────────────────────────────────────
DASHBOARD_USERNAME=supabase
# CHANGE THIS
DASHBOARD_PASSWORD=your-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=NETLIFE CASH
STUDIO_DEFAULT_PROJECT=VirtualBank

# ── Auth / GoTrue ────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=false

# ── SMTP (for password-reset emails) ─────────────────────
SMTP_ADMIN_EMAIL=noreply@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=NETLIFE CASH

# ── Kong Ports ───────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── Realtime ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY_BASE=your-secret-key-base-min-64-chars
REALTIME_DB_ENC_KEY=supabaserealtime

# ── Analytics ────────────────────────────────────────────
# Generate with: openssl rand -hex 20
LOGFLARE_API_KEY=your-logflare-api-key

# ── Image Proxy ──────────────────────────────────────────
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ── Edge Functions ───────────────────────────────────────
FUNCTIONS_VERIFY_JWT=false
